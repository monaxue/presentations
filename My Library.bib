@article{heesenPerceptualIntegrationBodily2024,
  title = {Perceptual Integration of Bodily and Facial Emotion Cues in Chimpanzees and Humans},
  author = {Heesen, Raphaela and Kim, Yena and Kret, Mariska E and Clay, Zanna},
  year = 2024,
  month = feb,
  journal = {PNAS Nexus},
  volume = {3},
