@online{sahiSharingBelievingSaying2025,
  title = {Sharing Is Believing: {{Saying}} or Writing Reframes of Emotional Experiences Boosts Cognitive Emotion Regulation},
  shorttitle = {Sharing Is Believing},
  author = {Sahi, Razia S and Challman, Angela and Nook, Erik C},
