@misc{ogibayashiModelStructureAgentBased2018,
  type = {{{SSRN Scholarly Paper}}},
  title = {Model {{Structure}} of {{Agent-Based Artificial System}} for {{Reproducing Bullying Phenomenon}}},
  author = {Ogibayashi, Shigeaki and Shinagawa, Kazuya},
  year = 2018,
  month = jun,
  number = {3200085},
