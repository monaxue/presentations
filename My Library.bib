  urldate = {2024-10-18},
  abstract = {Causal learning has traditionally been regarded as a process of forming epistemically accurate causal beliefs that represent the world. Yet, considering that a primary function of causal learning is to further people’s practical goals by increasing their control over their surroundings, perhaps people also evaluate the instrumental value of causal beliefs when forming them—that is, what are the causal beliefs that are most effective at realizing some outcome. We formalized these two processes of learning (epistemic vs instrumental) using a Bayesian generative framework and compared their respective model predictions to human causal inferences across four separate studies. In Studies 1-3, we showed that an instrumental learning account (compared to an epistemic learning account) provides a better explanation for people’s causal inferences, which also exhibited the conjunction bias, a well-established learning phenomenon. An instrumental account explains that people favor conjunctive causal explanations because acting according to these explanations maximizes the chance of attaining the desired outcome. In Study 4, we compared the instrumental account and epistemic accounts to an alternative variant that incorporated the intentionality of observed agents. Again, we showed that the instrumental account better fit human inferences, and the results could not be explained by intentionality. We discuss how these findings change current conceptualizations of causal learning, and relate to real-world examples like superstition and functional thinking.},
  archiveprefix = {OSF},
  langid = {american},
  file = {C:\Users\monaj\dev\Obsidian Vault\Zotero\ZotMoov\Teo and Ong - 2023 - Instrumental Causal Learning 1.pdf}
