  file = {C:\Users\monaj\dev\Obsidian Vault\Zotero\ZotMoov\Lange et al. - 2016 - The Evil Queen's Dilemma Linking Narcissistic Admiration and Rivalry to Benign and Malicious Envy.pdf}
