@article{boigerEssentialismCulturalDifferences2018,
  title = {Beyond Essentialism: {{Cultural}} Differences in Emotions Revisited.},
  shorttitle = {Beyond Essentialism},
  author = {Boiger, Michael and Ceulemans, Eva and De Leersnyder, Jozefien and Uchida, Yukiko and Norasakkunkit, Vinai and Mesquita, Batja},
  date = {2018-12-01},
