@article{schoutenCulturalDifferencesEmotion2020,
  title = {Cultural {{Differences}} in {{Emotion Suppression}} in {{Belgian}} and {{Japanese Couples}}: {{A Social Functional Model}}},
  shorttitle = {Cultural {{Differences}} in {{Emotion Suppression}} in {{Belgian}} and {{Japanese Couples}}},
  author = {Schouten, Anna and Boiger, Michael and Kirchner-Häusler, Alexander and Uchida, Yukiko and Mesquita, Batja},
  date = {2020-05-27},
  journaltitle = {Frontiers in Psychology},
  shortjournal = {Front. Psychol.},
