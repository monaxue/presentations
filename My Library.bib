@online{leeEmergenceRapidValue2026,
  title = {Emergence of Rapid Value Inference through Meta-Reinforcement Learning},
  author = {Lee, Jaeeon and Hennig, Jay A. and Frelih, Vanessa and Gershman, Samuel J. and Uchida, Naoshige},
  date = {2026-02-21},
  eprinttype = {bioRxiv},
