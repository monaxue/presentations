@article{condonBottomConstructionPersonality2020,
  title = {Bottom {{Up Construction}} of a {{Personality Taxonomy}}},
  author = {Condon, David M. and Wood, Dustin and Mõttus, René and Booth, Tom and Costantini, Giulio and Greiff, Samuel and Johnson, Wendy and Lukaszewski, Aaron and Murray, Aja and Revelle, William and Wright, Aidan G. C. and Ziegler, Matthias and Zimmermann, Johannes},
