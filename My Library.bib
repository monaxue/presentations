  keywords = {bilingualism,emotion perception,emotion words,facial expressions of emotion,second language},
  file = {C:\Users\monaj\dev\Obsidian Vault\Zotero\ZotMoov\Champoux-Larsson and Nook - 2024 - How first- and second-language emotion words influence emotion perception in Swedish–English bilingu.pdf}
