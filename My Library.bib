  urldate = {2026-06-10},
  abstract = {The "Greater Male Variability Hypothesis" (GMVH) of intelligence is a century-old idea that males have been over-represented in elite academic, political, and economic roles because they are more variable in intellectual ability than females. Proponents of the GMVH argue that males and females may have similar average intelligence, but greater male variability implies that males are over-represented at the extreme high end of the distribution. The evidence for this hypothesis is mixed but consists of greater male variance in intelligence test scores, especially from the early 20th century. While it is often assumed that intelligence measures are independent of test design procedures, I show, with computational modeling, that designing a test for one population leads to statistical irregularities when applied to another. For example, early intelligence tests were often designed to test intelligence in primarily male populations, including exclusively male Army draftees in the First World War or mostly male secondary school applicants. I show that typical question selection procedures, when used to design a test for males, tend to increase the variance of male scores relative to female scores. This suggests that greater male test score variance may be explained by biased test design, and other explanations are needed to explain male overrepresentation in elite positions.},
  archiveprefix = {Open Science Framework},
  copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
  file = {C:\Users\monaj\dev\Obsidian Vault\Zotero\ZotMoov\Zefferman - 2023 - Greater variance in male intelligence test scores can be explained by sex-biased test design.pdf}
}

